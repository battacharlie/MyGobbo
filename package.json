{
  "name": "mio-countdown",
  "version": "0.2.0",
  "description": "Regia video per Windows: uscita a tutto schermo sul secondo monitor con NDI, periferiche di acquisizione, timer e frase in sovraimpressione.",
  "main": "src/main.js",
  "author": "Batta",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.batta.miocountdown",
    "productName": "Mio Countdown",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/@stagetimerio/grandiose/dist/**"
    ]
  },
  "optionalDependencies": {
    "@stagetimerio/grandiose": "^0.2.0"
  }
}
