{
  "name": "igor-abits",
  "version": "0.4.11",
  "description": "IGOR - ABit/s: regia video per Windows con uscita a tutto schermo sul secondo monitor, NDI, periferiche di acquisizione, timer, banner in sovraimpressione, TelePrompt e scene.",
  "main": "src/main.js",
  "author": "ABit/s",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "dist:mac": "electron-builder --mac",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "node-gyp": "^13.1.0"
  },
  "build": {
    "appId": "com.abits.igor",
    "productName": "IGOR - ABits",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "IGOR-ABits-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "IGOR usa le telecamere e le schede di acquisizione come ingressi video. / IGOR uses cameras and capture cards as video inputs.",
        "NSMicrophoneUsageDescription": "IGOR può usare l'audio delle schede di acquisizione. / IGOR can use the audio of capture cards."
      }
    },
    "dmg": {
      "title": "IGOR - ABits ${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "IGOR - ABits",
      "uninstallDisplayName": "IGOR - ABit/s",
      "artifactName": "IGOR-ABits-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "asarUnpack": [
      "**/@stagetimerio/grandiose/dist/**"
    ],
    "npmRebuild": false,
    "portable": {
      "artifactName": "IGOR-ABits-${version}-portable.${ext}"
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "optionalDependencies": {
    "@stagetimerio/grandiose": "^0.2.0"
  }
}
